# re2 는 firebase-tools 의 전이 의존성, esbuild·protobufjs 는 워크스페이스 빌드에 필요.
# pnpm 11 이 명시 승인 없이는 빌드를 거부하므로 여기서 화이트리스트를 잠근다.
only-built-dependencies[]=esbuild
only-built-dependencies[]=protobufjs
only-built-dependencies[]=re2
verify-deps-before-run=false

# pnpm deploy 시 workspace 의존성을 실제 파일로 주입.
# Firebase Functions 배포는 Cloud Build 에서 npm 을 쓰는데 workspace: 프로토콜을
# 이해 못 하므로, 주입 방식으로 자립형 배포 산출물을 만든다.
inject-workspace-packages=true
