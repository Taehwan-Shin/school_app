{
  "functions": [
    {
      "source": "packages/functions/deploy",
      "codebase": "default",
      "ignore": [
        "node_modules/**",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "pnpm-lock.yaml",
        "src/**",
        "tests/**",
        "scripts/**",
        "eslint.config.js",
        "vitest.config.ts",
        "vitest.emu.config.ts",
        "firestore-debug.log",
        "tsconfig.json"
      ],
      "predeploy": [
        "node packages/functions/scripts/prepare-deploy.mjs"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "packages/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/getMe",
        "function": { "functionId": "getMe", "region": "asia-northeast3" }
      },
      {
        "source": "/api/usersList",
        "function": { "functionId": "usersList", "region": "asia-northeast3" }
      },
      {
        "source": "/api/usersCreate",
        "function": { "functionId": "usersCreate", "region": "asia-northeast3" }
      },
      {
        "source": "/api/usersUpdate",
        "function": { "functionId": "usersUpdate", "region": "asia-northeast3" }
      },
      {
        "source": "/api/usersDelete",
        "function": { "functionId": "usersDelete", "region": "asia-northeast3" }
      },
      {
        "source": "/api/groupsList",
        "function": { "functionId": "groupsList", "region": "asia-northeast3" }
      },
      {
        "source": "/api/auditLogList",
        "function": { "functionId": "auditLogList", "region": "asia-northeast3" }
      },
      {
        "source": "/api/groupsMembersUpdate",
        "function": { "functionId": "groupsMembersUpdate", "region": "asia-northeast3" }
      },
      {
        "source": "/api/basicDataGet",
        "function": { "functionId": "basicDataGet", "region": "asia-northeast3" }
      },
      {
        "source": "/api/basicDataSet",
        "function": { "functionId": "basicDataSet", "region": "asia-northeast3" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8085
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
